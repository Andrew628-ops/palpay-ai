
# PalPay AI — Example Environment Configuration

# DATABASE
# Use the absolute path to your project database.
DATABASE_URL=sqlite:////absolute/path/to/palpay-ai/palpay.db

# OPERATOR AUTHORIZATION
APPROVAL_TOKEN=replace-with-your-demo-approval-token

# PAYPAL SANDBOX
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id

PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret

PAYPAL_SANDBOX_RECEIVER_EMAIL=receiver@example.com

PAYPAL_WEBHOOK_ID=your-paypal-sandbox-webhook-id

GEMINI_API_KEY=your-gemini-api-key
